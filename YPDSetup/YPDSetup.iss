; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{7FC04037-1F96-47AD-B1B5-2EC2EA95BCF8}
AppName=YouTube Playlist Downloader Revamped
AppVersion=2.0.0
AppVerName=YouTube Playlist Downloader Revamped 2.0.0
AppPublisher=Daniel Freitas
AppPublisherURL=https://github.com/danfreitas97/YoutubePlaylistDownloaderRevamped
AppSupportURL=https://github.com/danfreitas97/YoutubePlaylistDownloaderRevamped
AppUpdatesURL=https://github.com/danfreitas97/YoutubePlaylistDownloaderRevamped
DefaultDirName={commonpf}\YouTube Playlist Downloader Revamped
DefaultGroupName=YouTube Playlist Downloader Revamped
AllowNoIcons=yes
OutputDir=output
OutputBaseFilename=YoutubePlaylistDownloaderRevamped-Setup
SetupIconFile=..\YoutubePlaylistDownloader\finalIcon.ico
Compression=lzma
SolidCompression=yes
UninstallDisplayIcon={app}\YoutubePlaylistDownloader.exe
; The app is published self-contained for 64-bit Windows: no separate .NET install needed.
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0
; Follows the Windows light/dark setting, like the app.
WizardStyle=modern dynamic
WizardImageFile=wizard-image-100.png,wizard-image-150.png,wizard-image-200.png
WizardSmallImageFile=wizard-small-100.png,wizard-small-150.png,wizard-small-200.png
; Dark mode has its own image directives; without them it falls back to the built-in pictures.
WizardImageFileDynamicDark=wizard-image-100.png,wizard-image-150.png,wizard-image-200.png
WizardSmallImageFileDynamicDark=wizard-small-100.png,wizard-small-150.png,wizard-small-200.png
; Ask for the language only when Windows uses one the installer does not have.
ShowLanguageDialog=auto
; Close a running copy before replacing its files.
CloseApplications=yes

[Languages]
Name: "brazilianportuguese"; MessagesFile: "compiler:Languages\BrazilianPortuguese.isl"
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "spanish"; MessagesFile: "compiler:Languages\Spanish.isl"
Name: "german"; MessagesFile: "compiler:Languages\German.isl"
Name: "french"; MessagesFile: "compiler:Languages\French.isl"
Name: "italian"; MessagesFile: "compiler:Languages\Italian.isl"
Name: "dutch"; MessagesFile: "compiler:Languages\Dutch.isl"
Name: "polish"; MessagesFile: "compiler:Languages\Polish.isl"
Name: "turkish"; MessagesFile: "compiler:Languages\Turkish.isl"
Name: "russian"; MessagesFile: "compiler:Languages\Russian.isl"
Name: "hebrew"; MessagesFile: "compiler:Languages\Hebrew.isl"
Name: "arabic"; MessagesFile: "compiler:Languages\Arabic.isl"
Name: "chinese"; MessagesFile: "ChineseSimplified.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}";

[Files]
Source: "publish\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

; NOTE: Don't use "Flags: ignoreversion" on any shared system files        

[Icons]
Name: "{group}\YouTube Playlist Downloader Revamped"; Filename: "{app}\YoutubePlaylistDownloader.exe"
Name: "{commondesktop}\YouTube Playlist Downloader Revamped"; Filename: "{app}\YoutubePlaylistDownloader.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\YoutubePlaylistDownloader.exe"; Description: "{cm:LaunchProgram,YouTube Playlist Downloader Revamped}"; Flags: nowait postinstall skipifsilent

