<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:YoutubePlaylistDownloader.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>

    <c:BoolToVisibilityConverter x:Key="Visible" />
    <c:BoolToVisibilityConverter x:Key="Collapsed" Invert="True" />
    <c:InverseBoolConverter x:Key="Not" />
    <c:EqualsConverter x:Key="Equals" />
    <c:FlagConverter x:Key="Flag" />
    <c:ProgressToDashArrayConverter x:Key="DashArray" />
    <c:PercentWidthConverter x:Key="PercentWidth" />
    <c:LocalizeConverter x:Key="Localize" />
    <c:ResourceConverter x:Key="Resource" />
    <c:ImageUrlConverter x:Key="ImageUrl" />

    <!-- ============ focus ============ -->
    <Style x:Key="Focus.Visual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="10" RadiusY="10" Stroke="{DynamicResource Blue}" StrokeThickness="2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ icon ============ -->
    <Style TargetType="c:Icon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Icon">
                    <Viewbox Stretch="Uniform">
                        <Path Width="24" Height="24" Stretch="None" Data="{TemplateBinding Data}"
                              Stroke="{TemplateBinding Foreground}" StrokeThickness="{TemplateBinding StrokeThickness}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ text ============ -->
    <Style x:Key="T.H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="T.H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="T.Sub" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
        <Setter Property="Foreground" Value="{DynamicResource Text2}" />
    </Style>
    <Style x:Key="T.Small" TargetType="TextBlock" BasedOn="{StaticResource T.Sub}">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="T.Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Text2}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
    </Style>

    <!-- ============ buttons ============ -->
    <ControlTemplate x:Key="Tpl.Button" TargetType="ButtonBase">
        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding c:Ui.CornerRadius}"
                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                <c:Icon x:Name="ic" Data="{TemplateBinding c:Ui.Icon}" Width="{TemplateBinding c:Ui.IconSize}" Height="{TemplateBinding c:Ui.IconSize}"
                        Foreground="{TemplateBinding Foreground}" Margin="-2,0,8,0" VerticalAlignment="Center" />
                <ContentPresenter x:Name="cp" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="c:Ui.Icon" Value="{x:Null}">
                <Setter TargetName="ic" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="ic" Property="Margin" Value="0" />
                <Setter TargetName="cp" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{Binding (c:Ui.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.82" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Btn.Base" TargetType="ButtonBase">
        <Setter Property="Template" Value="{StaticResource Tpl.Button}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="Btn.Pill" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="c:Ui.CornerRadius" Value="20" />
        <Setter Property="Background" Value="{DynamicResource Chip}" />
        <Setter Property="c:Ui.HoverBackground" Value="{DynamicResource ChipHover}" />
    </Style>

    <Style x:Key="Btn.PillSm" TargetType="Button" BasedOn="{StaticResource Btn.Pill}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="c:Ui.CornerRadius" Value="16" />
        <Setter Property="c:Ui.IconSize" Value="16" />
    </Style>

    <Style x:Key="Btn.Red" TargetType="Button" BasedOn="{StaticResource Btn.Pill}">
        <Setter Property="Background" Value="{DynamicResource Red}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="c:Ui.HoverBackground" Value="{DynamicResource Red}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.9" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Chip}" />
                <Setter Property="Foreground" Value="{DynamicResource Text2}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Btn.RedSm" TargetType="Button" BasedOn="{StaticResource Btn.Red}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="c:Ui.CornerRadius" Value="16" />
    </Style>

    <Style x:Key="Btn.RedBig" TargetType="Button" BasedOn="{StaticResource Btn.Red}">
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="26,0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="c:Ui.CornerRadius" Value="24" />
    </Style>

    <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn.Pill}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="c:Ui.HoverBackground" Value="{DynamicResource Hover}" />
    </Style>

    <Style x:Key="Btn.GhostSm" TargetType="Button" BasedOn="{StaticResource Btn.PillSm}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="c:Ui.HoverBackground" Value="{DynamicResource Hover}" />
    </Style>

    <Style x:Key="Btn.Link" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Blue}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="c:Ui.CornerRadius" Value="6" />
        <Setter Property="c:Ui.HoverBackground" Value="{DynamicResource Hover}" />
    </Style>

    <Style x:Key="Btn.Round" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="c:Ui.CornerRadius" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource Text2}" />
        <Setter Property="c:Ui.HoverBackground" Value="{DynamicResource Hover}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Btn.RoundSm" TargetType="Button" BasedOn="{StaticResource Btn.Round}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="c:Ui.CornerRadius" Value="16" />
        <Setter Property="c:Ui.IconSize" Value="18" />
    </Style>

    <Style x:Key="Btn.Window" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Foreground" Value="{DynamicResource Text2}" />
        <Setter Property="c:Ui.HoverBackground" Value="{DynamicResource Hover}" />
        <Setter Property="c:Ui.IconSize" Value="16" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>

    <Style x:Key="Btn.WindowClose" TargetType="Button" BasedOn="{StaticResource Btn.Window}">
        <Setter Property="c:Ui.HoverBackground" Value="#E81123" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Btn.Menu" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="c:Ui.CornerRadius" Value="10" />
        <Setter Property="c:Ui.HoverBackground" Value="{DynamicResource Hover}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding c:Ui.CornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{Binding (c:Ui.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ chips & segmented ============ -->
    <Style x:Key="ChipToggle" TargetType="ToggleButton" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="c:Ui.CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource Chip}" />
        <Setter Property="c:Ui.HoverBackground" Value="{DynamicResource ChipHover}" />
        <Setter Property="c:Ui.IconSize" Value="16" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource InvBg}" />
                <Setter Property="Foreground" Value="{DynamicResource InvText}" />
                <Setter Property="c:Ui.HoverBackground" Value="{DynamicResource InvBg}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChipRadio" TargetType="RadioButton" BasedOn="{StaticResource ChipToggle}" />

    <Style x:Key="Seg.Box" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="Seg" TargetType="RadioButton" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="c:Ui.CornerRadius" Value="16" />
        <Setter Property="c:Ui.IconSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource Text2}" />
        <Setter Property="c:Ui.HoverBackground" Value="{DynamicResource Hover}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource InvBg}" />
                <Setter Property="Foreground" Value="{DynamicResource InvText}" />
                <Setter Property="c:Ui.HoverBackground" Value="{DynamicResource InvBg}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ rail ============ -->
    <Style x:Key="RailItem" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Text2}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Width" Value="76" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Background="Transparent" Margin="0,4,0,6">
                        <Grid HorizontalAlignment="Center">
                            <Border x:Name="pill" Width="56" Height="32" CornerRadius="16" Background="Transparent" />
                            <c:Icon Data="{TemplateBinding c:Ui.Icon}" Width="22" Height="22" Foreground="{TemplateBinding Foreground}" />
                            <Path x:Name="ring" Width="56" Height="32" Stretch="None" Stroke="{DynamicResource Red}" StrokeThickness="2"
                                  StrokeDashCap="Round"
                                  StrokeDashArray="{Binding (c:Ui.Progress), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DashArray}}">
                                <Path.Data>
                                    <RectangleGeometry Rect="1,1,54,30" RadiusX="15" RadiusY="15" />
                                </Path.Data>
                            </Path>
                            <Border x:Name="badge" MinWidth="18" Height="18" Padding="5,0" CornerRadius="9" Background="{DynamicResource Red}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,0,0">
                                <TextBlock Text="{TemplateBinding c:Ui.Badge}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ContentPresenter HorizontalAlignment="Center" Margin="0,4,0,0" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="pill" Property="Background" Value="{DynamicResource Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="pill" Property="Background" Value="{DynamicResource ChipHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        </Trigger>
                        <Trigger Property="c:Ui.Progress" Value="0">
                            <Setter TargetName="ring" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="c:Ui.Badge" Value="{x:Null}">
                            <Setter TargetName="badge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="c:Ui.Badge" Value="">
                            <Setter TargetName="badge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ switch ============ -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Border x:Name="track" Width="36" Height="14" CornerRadius="7" Background="{DynamicResource ChipHover}" />
                        <Ellipse x:Name="knob" Width="20" Height="20" Fill="{DynamicResource Knob}" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="tx" X="-12" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.45" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource RedTrack}" />
                            <Setter TargetName="knob" Property="Fill" Value="{DynamicResource Red}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="12" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="-12" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ checkbox ============ -->
    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="4" BorderThickness="2" BorderBrush="{DynamicResource Text2}" VerticalAlignment="Center">
                            <Grid>
                                <c:Icon x:Name="check" Data="{StaticResource I.Check}" Width="14" Height="14" StrokeThickness="3" Foreground="White" Visibility="Collapsed" />
                                <Border x:Name="dash" Width="8" Height="2" Background="White" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource Red}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Red}" />
                            <Setter TargetName="check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource Red}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Red}" />
                            <Setter TargetName="dash" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ text boxes ============ -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Blue}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="c:Ui.CornerRadius" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding c:Ui.CornerRadius}" SnapsToDevicePixels="True">
                        <Grid Margin="{TemplateBinding Padding}">
                            <TextBlock x:Name="ph" Text="{TemplateBinding c:Ui.Placeholder}" Foreground="{DynamicResource Text2}" FontSize="{TemplateBinding FontSize}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- borderless text box used inside composite fields (the link box, the search pill) -->
    <Style x:Key="TextBox.Bare" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ============ combo box (pill dropdown) ============ -->
    <Style x:Key="ComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="12,0" Height="36">
                        <Grid>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,24,0" />
                            <c:Icon x:Name="ok" Data="{StaticResource I.Check}" Width="16" Height="16" HorizontalAlignment="Right" Foreground="{DynamicResource Red}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ok" Property="Visibility" Value="Visible" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="20" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="14,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <c:Icon Data="{StaticResource I.ChevDown}" Width="18" Height="18" Margin="0,0,12,0" HorizontalAlignment="Right" Foreground="{DynamicResource Text2}" IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Fade" VerticalOffset="4">
                            <Border Margin="12,4,12,16" Background="{DynamicResource Menu}" CornerRadius="14" Padding="6"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" />
                                </Border.Effect>
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ scroll bars ============ -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="bd" CornerRadius="4" Background="{DynamicResource ChipHover}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Line2}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="3,4">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="4,3">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ progress ============ -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource Red}" />
        <Setter Property="Background" Value="{DynamicResource Chip}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="root" CornerRadius="3" Background="{TemplateBinding Background}" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{TemplateBinding Foreground}" />
                            <Border x:Name="sweep" Width="90" HorizontalAlignment="Left" CornerRadius="3" Background="{TemplateBinding Foreground}" Visibility="Collapsed">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="sweepX" X="-90" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="sweep" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="sweepAnim">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="sweepX" Storyboard.TargetProperty="X" From="-90" To="900" Duration="0:0:1.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="sweepAnim" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ expander ============ -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource Text2}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="header" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Cursor="Hand"
                                      FocusVisualStyle="{StaticResource Focus.Visual}" HorizontalAlignment="Left">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <StackPanel Orientation="Horizontal" Background="Transparent">
                                        <ContentPresenter VerticalAlignment="Center" />
                                        <c:Icon x:Name="chev" Data="{StaticResource I.ChevDown}" Width="16" Height="16" Margin="4,0,0,0" Foreground="{DynamicResource Text2}" />
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="chev" Property="Data" Value="{StaticResource I.ChevUp}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </ToggleButton>
                        <ContentPresenter x:Name="content" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="content" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ tooltip ============ -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource InvText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource InvBg}" CornerRadius="8" Padding="10,6" Margin="6">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ surfaces ============ -->
    <Style x:Key="Box" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
    </Style>

    <Style x:Key="PopupCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Menu}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="16" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.35" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Line}" />
    </Style>
</ResourceDictionary>
