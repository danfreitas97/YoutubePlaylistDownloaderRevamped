<Window x:Class="YoutubePlaylistDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:YoutubePlaylistDownloader.Controls"
        xmlns:v="clr-namespace:YoutubePlaylistDownloader.Views"
        Title="{DynamicResource Title}"
        Width="1280" Height="820" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource Font.Text}"
        FontSize="14"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FlowDirection="{Binding FlowDirection}"
        Icon="finalIcon.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding TaskbarState}" ProgressValue="{Binding TaskbarProgress}" />
    </Window.TaskbarItemInfo>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding Dialog.DismissCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="download" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="downloads" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="settings" />
    </Window.InputBindings>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ rail ============ -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Width="92">
            <DockPanel LastChildFill="False" Margin="0,14,0,12">
                <Button DockPanel.Dock="Top" Style="{StaticResource Btn.Base}" Padding="6" c:Ui.CornerRadius="10" HorizontalAlignment="Center" Margin="0,0,0,22"
                        WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding NavigateCommand}" CommandParameter="download"
                        ToolTip="{DynamicResource Title}" AutomationProperties.Name="{DynamicResource Title}">
                    <Border Width="40" Height="28" CornerRadius="8" Background="{DynamicResource Red}">
                        <c:Icon Data="{StaticResource I.Logo}" Width="20" Height="20" Foreground="White" StrokeThickness="2.4" />
                    </Border>
                </Button>

                <RadioButton DockPanel.Dock="Top" Style="{StaticResource RailItem}" GroupName="nav" c:Ui.Icon="{StaticResource I.Download}"
                             Content="{DynamicResource NavDownload}"
                             IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=download}" />
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource RailItem}" GroupName="nav" c:Ui.Icon="{StaticResource I.Queue}"
                             Content="{DynamicResource NavDownloads}"
                             IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=downloads}"
                             c:Ui.Badge="{Binding ActiveBadge}" c:Ui.Progress="{Binding OverallProgress}" />
                <RadioButton DockPanel.Dock="Top" Style="{StaticResource RailItem}" GroupName="nav" c:Ui.Icon="{StaticResource I.Gear}"
                             Content="{DynamicResource Settings}"
                             IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=settings}" />

                <!-- theme toggle (bottom) -->
                <Button DockPanel.Dock="Bottom" Width="48" Height="48" c:Ui.CornerRadius="24" HorizontalAlignment="Center"
                        Command="{Binding ToggleThemeCommand}" ToolTip="{DynamicResource ToggleTheme}" AutomationProperties.Name="{DynamicResource ToggleTheme}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Btn.Round}">
                            <Setter Property="c:Ui.Icon" Value="{StaticResource I.Moon}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDark}" Value="True">
                                    <Setter Property="c:Ui.Icon" Value="{StaticResource I.Sun}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- language picker, above the theme toggle -->
                <Grid DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <ToggleButton x:Name="LanguageButton" Width="48" Height="48" Cursor="Hand" FocusVisualStyle="{StaticResource Focus.Visual}"
                                  IsChecked="{Binding IsLanguageMenuOpen, Mode=TwoWay}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=LanguagePopup, Converter={StaticResource Not}}"
                                  ToolTip="{DynamicResource ChangeLanguage}" AutomationProperties.Name="{DynamicResource ChangeLanguage}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="bd" CornerRadius="24" Background="Transparent">
                                    <Border Width="26" Height="18" CornerRadius="4" BorderBrush="{DynamicResource Line2}" BorderThickness="1" SnapsToDevicePixels="True">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding CurrentLanguage, Converter={StaticResource Flag}}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource ChipHover}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Popup x:Name="LanguagePopup" PlacementTarget="{Binding ElementName=LanguageButton}" Placement="Right" HorizontalOffset="4" VerticalOffset="-300"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                           IsOpen="{Binding IsLanguageMenuOpen, Mode=TwoWay}">
                        <Border Style="{StaticResource PopupCard}" Width="260">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Language}" Style="{StaticResource T.Section}" Margin="12,8,12,6" />
                                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Languages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource Btn.Menu}" Command="{Binding DataContext.ChangeLanguageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Name}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="24" Height="16" CornerRadius="3" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding Name, Converter={StaticResource Flag}}" Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource Text}" />
                                                        <c:Icon Grid.Column="2" Data="{StaticResource I.Check}" Width="16" Height="16" Foreground="{DynamicResource Red}"
                                                                Visibility="{Binding IsCurrent, Converter={StaticResource Visible}}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Popup>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ============ content ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- caption area: draggable, with the window buttons (always on the physical right) -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="LeftToRight" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource Btn.Window}" c:Ui.Icon="{StaticResource I.Minimize}" Click="Minimize_Click" AutomationProperties.Name="Minimize" />
                <Button x:Name="MaximizeButton" Style="{StaticResource Btn.Window}" c:Ui.Icon="{StaticResource I.Maximize}" Click="Maximize_Click" AutomationProperties.Name="Maximize" />
                <Button Style="{StaticResource Btn.WindowClose}" c:Ui.Icon="{StaticResource I.Close}" Click="Close_Click" AutomationProperties.Name="Close" />
            </StackPanel>

            <v:DownloadView Grid.Row="1" DataContext="{Binding Download}" Visibility="{Binding DataContext.IsDownloadPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />
            <v:DownloadsView Grid.Row="1" DataContext="{Binding Downloads}" Visibility="{Binding DataContext.IsDownloadsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />
            <v:SettingsView Grid.Row="1" DataContext="{Binding Settings}" Visibility="{Binding DataContext.IsSettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />
        </Grid>

        <!-- ============ snackbar ============ -->
        <Border Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="92,0,0,108"
                Background="{DynamicResource InvBg}" CornerRadius="24" Padding="20,6,6,6" MinHeight="48"
                Visibility="{Binding IsSnackVisible, Converter={StaticResource Visible}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.35" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SnackText}" Foreground="{DynamicResource InvText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Style="{StaticResource Btn.Ghost}" Height="36" Content="{Binding SnackActionText}" Foreground="{DynamicResource InvText}"
                        Command="{Binding SnackActCommand}" Visibility="{Binding SnackActionText, Converter={StaticResource Visible}}" c:Ui.HoverBackground="#22808080" />
            </StackPanel>
        </Border>

        <!-- ============ dialog ============ -->
        <Grid Grid.ColumnSpan="2" Background="{DynamicResource Overlay}" DataContext="{Binding Dialog}"
              Visibility="{Binding IsOpen, Converter={StaticResource Visible}}">
            <Grid.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding DismissCommand}" />
            </Grid.InputBindings>
            <Border Background="{DynamicResource Menu}" CornerRadius="20" Padding="28,24" MaxWidth="560" MinWidth="380" Margin="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    MouseLeftButtonDown="DialogCard_MouseLeftButtonDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.4" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.H2}" FontSize="20" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Padding="0" MinHeight="0"
                                 Background="Transparent" Foreground="{DynamicResource Text2}" FontSize="14" VerticalContentAlignment="Top" />
                    </ScrollViewer>
                    <ProgressBar Margin="0,18,0,0" Maximum="100" Value="{Binding Progress}" Visibility="{Binding ShowProgress, Converter={StaticResource Visible}}" />
                    <ItemsControl ItemsSource="{Binding Buttons}" Margin="0,24,0,0" HorizontalAlignment="Right">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Right" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,4,0,0">
                                    <Button Style="{StaticResource Btn.Red}" Content="{Binding Text}" Visibility="{Binding IsPrimary, Converter={StaticResource Visible}}"
                                            Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Result}" IsDefault="{Binding IsPrimary}" />
                                    <Button Style="{StaticResource Btn.Pill}" Content="{Binding Text}" Visibility="{Binding IsPrimary, Converter={StaticResource Collapsed}}"
                                            Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Result}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
