<UserControl x:Class="YoutubePlaylistDownloader.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:YoutubePlaylistDownloader.Controls"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel">

    <UserControl.Resources>
        <!-- check circle shared by both layouts -->
        <ControlTemplate x:Key="CheckCircle" TargetType="ContentControl">
            <Border x:Name="circle" Width="26" Height="26" CornerRadius="13" BorderThickness="2" BorderBrush="White" Background="#59000000">
                <c:Icon x:Name="mark" Data="{StaticResource I.Check}" Width="15" Height="15" StrokeThickness="3" Foreground="White" Visibility="Collapsed" />
            </Border>
            <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="circle" Property="Background" Value="{DynamicResource Red}" />
                    <Setter TargetName="circle" Property="BorderBrush" Value="{DynamicResource Red}" />
                    <Setter TargetName="mark" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="CardToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
            <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        </Style>

        <!-- grid card -->
        <DataTemplate x:Key="GridItem">
            <ToggleButton Style="{StaticResource CardToggle}" Margin="8,8,8,4">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Background="Transparent">
                            <Grid>
                                <Border x:Name="ring" CornerRadius="15" BorderThickness="2.5" BorderBrush="{DynamicResource Red}" Margin="-5" Visibility="Collapsed" />
                                <Border x:Name="thumb" Height="132" CornerRadius="12" Background="{DynamicResource Chip}" ClipToBounds="True">
                                    <Border CornerRadius="12">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding ThumbnailUrl, Converter={StaticResource ImageUrl}, ConverterParameter=360}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Border>
                                <ContentControl Template="{StaticResource CheckCircle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Focusable="False" />
                                <Border Background="#CC000000" CornerRadius="4" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                                        Visibility="{Binding HasDuration, Converter={StaticResource Visible}}">
                                    <TextBlock Text="{Binding Duration}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <TextBlock x:Name="title" Text="{Binding Title}" Margin="2,12,2,0" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" MaxHeight="40" LineHeight="20" Foreground="{DynamicResource Text}" />
                            <StackPanel Orientation="Horizontal" Margin="2,6,0,0" Visibility="{Binding Exists, Converter={StaticResource Visible}}">
                                <c:Icon Data="{StaticResource I.CheckCircle}" Width="14" Height="14" Foreground="{DynamicResource Text2}" />
                                <TextBlock Text="{DynamicResource AlreadyInFolder}" Style="{StaticResource T.Small}" Margin="5,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="thumb" Property="Opacity" Value="0.45" />
                                <Setter TargetName="title" Property="Foreground" Value="{DynamicResource Text2}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumb" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-2" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
        </DataTemplate>

        <!-- list row -->
        <DataTemplate x:Key="ListItem">
            <ToggleButton Style="{StaticResource CardToggle}" Margin="0,1">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="12" Padding="8" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Template="{StaticResource CheckCircle}" VerticalAlignment="Center" Margin="4,0,0,0" Focusable="False" />
                                <TextBlock Grid.Column="1" Text="{Binding Number}" Style="{StaticResource T.Sub}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Grid Grid.Column="2">
                                    <Border x:Name="thumb" Width="160" Height="90" CornerRadius="8" Background="{DynamicResource Chip}">
                                        <Border CornerRadius="8">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding ThumbnailUrl, Converter={StaticResource ImageUrl}, ConverterParameter=320}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                    <Border Background="#CC000000" CornerRadius="4" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"
                                            Visibility="{Binding HasDuration, Converter={StaticResource Visible}}">
                                        <TextBlock Text="{Binding Duration}" Foreground="White" FontSize="11.5" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="3" Margin="16,0,8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="title" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Channel}" Style="{StaticResource T.Small}" />
                                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0" Visibility="{Binding Exists, Converter={StaticResource Visible}}">
                                            <c:Icon Data="{StaticResource I.CheckCircle}" Width="14" Height="14" Foreground="{DynamicResource Text2}" />
                                            <TextBlock Text="{DynamicResource AlreadyInFolder}" Style="{StaticResource T.Small}" Margin="5,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="thumb" Property="Opacity" Value="0.45" />
                                <Setter TargetName="title" Property="Foreground" Value="{DynamicResource Text2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
        </DataTemplate>

        <Style x:Key="VideoList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,4,0,140" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate" Value="{StaticResource GridItem}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel ItemSize="252,214" SpacingMode="None" StretchItems="True" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGridLayout}" Value="False">
                    <Setter Property="ItemTemplate" Value="{StaticResource ListItem}" />
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ===================== 1. paste a link ===================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
            <StackPanel MaxWidth="780" Margin="40,24,40,48">
                <Border Width="64" Height="45" CornerRadius="13" Background="{DynamicResource Red}" HorizontalAlignment="Center" Margin="0,24,0,20">
                    <c:Icon Data="{StaticResource I.Logo}" Width="30" Height="30" Foreground="White" StrokeThickness="2.4" />
                </Border>
                <TextBlock Text="{DynamicResource HeroTitle}" Style="{StaticResource T.H1}" FontSize="40" TextAlignment="Center" />
                <TextBlock Text="{DynamicResource HeroSubtitle}" Style="{StaticResource T.Sub}" FontSize="16" TextAlignment="Center" Margin="0,10,0,32" />

                <!-- link found on the clipboard -->
                <Border Background="{DynamicResource RedSoft}" CornerRadius="16" Padding="16,10,10,10" Margin="0,0,0,16"
                        Visibility="{Binding ShowClipboardBanner, Converter={StaticResource Visible}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <c:Icon Data="{StaticResource I.Paste}" Width="22" Height="22" Foreground="{DynamicResource Red}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource ClipboardFound}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ClipboardLink}" Style="{StaticResource T.Small}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource Btn.RedSm}" Content="{DynamicResource UseThisLink}" Command="{Binding UseClipboardCommand}" />
                        <Button Grid.Column="3" Style="{StaticResource Btn.RoundSm}" c:Ui.Icon="{StaticResource I.X}" Margin="4,0,0,0"
                                Command="{Binding DismissClipboardCommand}" ToolTip="{DynamicResource Dismiss}" AutomationProperties.Name="{DynamicResource Dismiss}" />
                    </Grid>
                </Border>

                <!-- the drop zone with the link field -->
                <Grid x:Name="DropZone" AllowDrop="True" PreviewDragOver="DropZone_DragOver" PreviewDragEnter="DropZone_DragOver"
                      PreviewDragLeave="DropZone_DragLeave" PreviewDrop="DropZone_Drop">
                    <Rectangle x:Name="DropOutline" RadiusX="24" RadiusY="24" Stroke="{DynamicResource Line2}" StrokeThickness="2" StrokeDashArray="4 3" Fill="Transparent" />
                    <StackPanel Margin="26,24">
                        <TextBlock Text="{DynamicResource LinkLabel}" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="{DynamicResource LinkHelp}" Style="{StaticResource T.Sub}" Margin="0,4,0,14" />

                        <Border CornerRadius="16" BorderThickness="1" Background="{DynamicResource Bg}" Padding="16,0,8,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Text}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding DetectionBad}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Red}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <c:Icon Data="{StaticResource I.Link}" Width="22" Height="22" Foreground="{DynamicResource Text2}" VerticalAlignment="Top" Margin="0,17,12,0" />
                                <TextBox x:Name="LinkBox" Grid.Column="1" Style="{StaticResource TextBox.Bare}" FontSize="16"
                                         Text="{Binding LinkText, UpdateSourceTrigger=PropertyChanged}"
                                         c:Ui.Placeholder="{DynamicResource LinkPlaceholder}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="170" Padding="0,16"
                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                         PreviewKeyDown="LinkBox_PreviewKeyDown" AutomationProperties.Name="{DynamicResource LinkLabel}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,12,0,0">
                                    <Button Style="{StaticResource Btn.PillSm}" c:Ui.Icon="{StaticResource I.Paste}" Content="{DynamicResource Paste}" Command="{Binding PasteCommand}"
                                            Visibility="{Binding LinkText, Converter={StaticResource Collapsed}}" />
                                    <Button Style="{StaticResource Btn.RoundSm}" c:Ui.Icon="{StaticResource I.X}" Command="{Binding ClearCommand}"
                                            Visibility="{Binding LinkText, Converter={StaticResource Visible}}"
                                            ToolTip="{DynamicResource Clear}" AutomationProperties.Name="{DynamicResource Clear}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- what was recognized -->
                        <StackPanel Orientation="Horizontal" Margin="2,10,0,0" MinHeight="22">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding DetectionOk, Converter={StaticResource Visible}}">
                                <c:Icon Data="{StaticResource I.CheckCircle}" Width="16" Height="16" Foreground="{DynamicResource Green}" />
                                <TextBlock Text="{Binding DetectionText}" Foreground="{DynamicResource Green}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding DetectionBad, Converter={StaticResource Visible}}">
                                <c:Icon Data="{StaticResource I.Alert}" Width="16" Height="16" Foreground="{DynamicResource Red}" />
                                <TextBlock Text="{Binding DetectionText}" Foreground="{DynamicResource Red}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <DockPanel Margin="2,4,0,0" Visibility="{Binding LoadError, Converter={StaticResource Visible}}">
                            <c:Icon DockPanel.Dock="Left" Data="{StaticResource I.Alert}" Width="16" Height="16" Foreground="{DynamicResource Red}" VerticalAlignment="Top" Margin="0,1,6,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding LoadError}" Foreground="{DynamicResource Red}" FontSize="13" TextWrapping="Wrap" />
                                <Button Style="{StaticResource Btn.Link}" Content="{DynamicResource SignInHint}" HorizontalAlignment="Left" Margin="-6,2,0,0" FontSize="13"
                                        Command="{Binding SignInCommand}" Visibility="{Binding IsRateLimited, Converter={StaticResource Visible}}" />
                            </StackPanel>
                        </DockPanel>

                        <WrapPanel Margin="0,16,0,0">
                            <Button Style="{StaticResource Btn.RedBig}" Command="{Binding LoadCommand}" Margin="0,0,16,0" AutomationProperties.Name="{DynamicResource FindVideos}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource FindVideos}" FontSize="16" VerticalAlignment="Center" />
                                    <c:Icon Data="{StaticResource I.Down}" Width="20" Height="20" Margin="8,0,-4,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8">
                                <c:Icon Data="{StaticResource I.Cursor}" Width="16" Height="16" Foreground="{DynamicResource Text2}" />
                                <TextBlock Text="{DynamicResource OrDragLink}" Style="{StaticResource T.Small}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <!-- signed out: what signing in gives -->
                <Border Style="{StaticResource Box}" CornerRadius="16" Padding="16,12,12,12" Margin="0,24,0,0"
                        Visibility="{Binding IsSignedIn, Converter={StaticResource Collapsed}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <c:Icon Data="{StaticResource I.Music}" Width="22" Height="22" Foreground="{DynamicResource Red}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource LibrarySignInTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource LibrarySignInHint}" Style="{StaticResource T.Small}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource Btn.RedSm}" Content="{DynamicResource SignInWithYoutube}" Command="{Binding SignInCommand}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- signed in: liked music and the account's playlists -->
                <StackPanel Margin="0,32,0,0" Visibility="{Binding IsSignedIn, Converter={StaticResource Visible}}">
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.RoundSm}" c:Ui.Icon="{StaticResource I.Retry}" Command="{Binding RefreshLibraryCommand}"
                                ToolTip="{DynamicResource LibraryRefresh}" AutomationProperties.Name="{DynamicResource LibraryRefresh}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource LibraryTitle}" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="{DynamicResource LibraryHint}" Style="{StaticResource T.Sub}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="{DynamicResource LibraryLoading}" Style="{StaticResource T.Small}" Margin="2,8,0,0"
                               Visibility="{Binding IsLibraryLoading, Converter={StaticResource Visible}}" />

                    <DockPanel Margin="2,8,0,0" Visibility="{Binding LibraryError, Converter={StaticResource Visible}}">
                        <c:Icon DockPanel.Dock="Left" Data="{StaticResource I.Alert}" Width="16" Height="16" Foreground="{DynamicResource Red}" VerticalAlignment="Top" Margin="0,1,6,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding LibraryError}" Foreground="{DynamicResource Red}" FontSize="13" TextWrapping="Wrap" />
                            <Button Style="{StaticResource Btn.Link}" Content="{DynamicResource SignInWithYoutube}" HorizontalAlignment="Left" Margin="-6,2,0,0" FontSize="13"
                                    Command="{Binding SignInCommand}" />
                        </StackPanel>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Library}" Margin="-6,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Btn.Base}" Padding="6" Margin="0,2" c:Ui.CornerRadius="14" c:Ui.HoverBackground="{DynamicResource Hover}"
                                        HorizontalContentAlignment="Stretch" VerticalAlignment="Top"
                                        Command="{Binding DataContext.OpenLibraryPlaylistCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                        ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
                                    <StackPanel>
                                        <Grid Height="96">
                                            <Border x:Name="thumb" CornerRadius="12" Background="{DynamicResource Chip}" ClipToBounds="True">
                                                <Border CornerRadius="12">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding ThumbnailUrl, Converter={StaticResource ImageUrl}, ConverterParameter=320}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                            </Border>
                                            <c:Icon x:Name="icon" Data="{StaticResource I.List}" Width="28" Height="28" Foreground="{DynamicResource Text2}"
                                                    Visibility="{Binding ThumbnailUrl, Converter={StaticResource Collapsed}}" />
                                            <Border Background="#CC000000" CornerRadius="4" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                                                    Visibility="{Binding CountText, Converter={StaticResource Visible}}">
                                                <TextBlock Text="{Binding CountText}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Title}" Margin="2,8,2,2" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="38" LineHeight="19" TextAlignment="Left" Foreground="{DynamicResource Text}" />
                                    </StackPanel>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsLikedMusic}" Value="True">
                                        <Setter TargetName="thumb" Property="Background" Value="{DynamicResource Red}" />
                                        <Setter TargetName="icon" Property="Data" Value="{StaticResource I.Music}" />
                                        <Setter TargetName="icon" Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- what can be downloaded -->
                <UniformGrid Columns="4" Margin="-6,24,-6,0">
                    <Border Style="{StaticResource Box}" CornerRadius="16" Padding="14" Margin="6">
                        <StackPanel>
                            <c:Icon Data="{StaticResource I.Film}" Width="22" Height="22" Foreground="{DynamicResource Red}" HorizontalAlignment="Left" />
                            <TextBlock Text="{DynamicResource Video}" FontWeight="SemiBold" Margin="0,8,0,2" />
                            <TextBlock Text="youtube.com/watch?v=…&#10;youtu.be/…" Style="{StaticResource T.Small}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Box}" CornerRadius="16" Padding="14" Margin="6">
                        <StackPanel>
                            <c:Icon Data="{StaticResource I.List}" Width="22" Height="22" Foreground="{DynamicResource Red}" HorizontalAlignment="Left" />
                            <TextBlock Text="{DynamicResource Playlist}" FontWeight="SemiBold" Margin="0,8,0,2" />
                            <TextBlock Text="youtube.com/playlist?list=…" Style="{StaticResource T.Small}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Box}" CornerRadius="16" Padding="14" Margin="6">
                        <StackPanel>
                            <c:Icon Data="{StaticResource I.User}" Width="22" Height="22" Foreground="{DynamicResource Red}" HorizontalAlignment="Left" />
                            <TextBlock Text="{DynamicResource TypeChannel}" FontWeight="SemiBold" Margin="0,8,0,2" />
                            <TextBlock Text="youtube.com/@…" Style="{StaticResource T.Small}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Box}" CornerRadius="16" Padding="14" Margin="6">
                        <StackPanel>
                            <c:Icon Data="{StaticResource I.Stack}" Width="22" Height="22" Foreground="{DynamicResource Red}" HorizontalAlignment="Left" />
                            <TextBlock Text="{DynamicResource TypeMany}" FontWeight="SemiBold" Margin="0,8,0,2" />
                            <TextBlock Text="{DynamicResource TypeManyHint}" Style="{StaticResource T.Small}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <!-- ===================== 2. loading ===================== -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40,0,40,80" Visibility="{Binding IsLoading, Converter={StaticResource Visible}}">
            <Grid Width="48" Height="48" Margin="0,0,0,18">
                <Ellipse Stroke="{DynamicResource Chip}" StrokeThickness="4" />
                <Path Stroke="{DynamicResource Red}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M24,2 A22,22 0 0 1 46,24" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotation" />
                    </Path.RenderTransform>
                    <Path.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.8" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Path.Triggers>
                </Path>
            </Grid>
            <TextBlock Text="{DynamicResource LoadingTitle}" Style="{StaticResource T.H2}" FontSize="20" HorizontalAlignment="Center" />
            <TextBlock Text="{DynamicResource LoadingSubtitle}" Style="{StaticResource T.Sub}" HorizontalAlignment="Center" Margin="0,4,0,20" />
            <Button Style="{StaticResource Btn.Pill}" Content="{DynamicResource Cancel}" Command="{Binding ChangeLinkCommand}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- ===================== 3. pick and download ===================== -->
        <Grid Margin="40,4,40,0" Visibility="{Binding IsLoaded, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- link bar -->
            <Border Grid.Row="0" Style="{StaticResource Box}" CornerRadius="28" Padding="16,8,8,8" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <c:Icon Data="{StaticResource I.Link}" Foreground="{DynamicResource Text2}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding LoadedLink}" Style="{StaticResource T.Sub}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="12,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <c:Icon Data="{StaticResource I.CheckCircle}" Width="16" Height="16" Foreground="{DynamicResource Green}" />
                        <TextBlock Text="{Binding FoundText}" Foreground="{DynamicResource Green}" FontWeight="SemiBold" FontSize="13" Margin="6,0,0,0" />
                    </StackPanel>
                    <Button Grid.Column="3" Style="{StaticResource Btn.PillSm}" Content="{DynamicResource ChangeLink}" Command="{Binding ChangeLinkCommand}" />
                </Grid>
            </Border>

            <!-- source header -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="224" Height="126" CornerRadius="12" Background="{DynamicResource Chip}">
                    <Border CornerRadius="12">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding SourceThumbnail, Converter={StaticResource ImageUrl}, ConverterParameter=480}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Border>
                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{Binding SourceKindIcon, Converter={StaticResource Resource}}" Width="15" Height="15" Foreground="{DynamicResource Red}" />
                        <TextBlock Text="{Binding SourceKindText}" Foreground="{DynamicResource Red}" FontSize="12" FontWeight="Bold" Margin="6,0,0,0" Typography.Capitals="AllSmallCaps" />
                    </StackPanel>
                    <TextBlock Text="{Binding SourceTitle}" Style="{StaticResource T.H1}" FontSize="30" Margin="0,4,0,8" MaxHeight="80" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource T.Body}">
                        <Run Text="{Binding SourceAuthor, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="{Binding SourceAuthorSeparator, Mode=OneWay}" Foreground="{DynamicResource Text2}" />
                        <Run Text="{Binding SourceMeta, Mode=OneWay}" Foreground="{DynamicResource Text2}" />
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- tools -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1" Padding="0,10" Margin="0,0,0,8">
                <DockPanel LastChildFill="False">
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding SelectAllState, Mode=TwoWay}" VerticalAlignment="Center" Margin="4,0,20,0">
                        <TextBlock Text="{Binding SelectionText}" />
                    </CheckBox>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <RadioButton Style="{StaticResource ChipRadio}" Margin="0,0,8,0" IsChecked="{Binding ListFilter, Converter={StaticResource Equals}, ConverterParameter=all}">
                            <TextBlock><Run Text="{DynamicResource FilterAll}" /> <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Normal" /></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ChipRadio}" Margin="0,0,8,0" IsChecked="{Binding ListFilter, Converter={StaticResource Equals}, ConverterParameter=sel}">
                            <TextBlock><Run Text="{DynamicResource FilterSelected}" /> <Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="Normal" /></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ChipRadio}" Margin="0,0,8,0" IsChecked="{Binding ListFilter, Converter={StaticResource Equals}, ConverterParameter=exists}"
                                     Visibility="{Binding ExistingCount, Converter={StaticResource Visible}}">
                            <TextBlock><Run Text="{DynamicResource FilterExisting}" /> <Run Text="{Binding ExistingCount, Mode=OneWay}" FontWeight="Normal" /></TextBlock>
                        </RadioButton>
                    </StackPanel>

                    <Border DockPanel.Dock="Right" Style="{StaticResource Seg.Box}" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Seg}" c:Ui.Icon="{StaticResource I.Grid}" Padding="10,0" IsChecked="{Binding IsGridLayout}"
                                         ToolTip="{DynamicResource GridView}" AutomationProperties.Name="{DynamicResource GridView}" />
                            <RadioButton Style="{StaticResource Seg}" c:Ui.Icon="{StaticResource I.Rows}" Padding="10,0" IsChecked="{Binding IsGridLayout, Converter={StaticResource Not}}"
                                         ToolTip="{DynamicResource ListView}" AutomationProperties.Name="{DynamicResource ListView}" />
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Right" Height="38" Width="240" CornerRadius="19" Padding="14,0" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Text}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <c:Icon DockPanel.Dock="Left" Data="{StaticResource I.Search}" Width="18" Height="18" Foreground="{DynamicResource Text2}" />
                            <TextBox Style="{StaticResource TextBox.Bare}" FontSize="14" Margin="8,0,0,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     c:Ui.Placeholder="{DynamicResource SearchInList}" AutomationProperties.Name="{DynamicResource SearchInList}" />
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- videos -->
            <ListBox Grid.Row="3" Style="{StaticResource VideoList}" ItemsSource="{Binding VideosView}" Margin="-8,0,-8,0" />
            <TextBlock Grid.Row="3" Text="{DynamicResource NothingFound}" Style="{StaticResource T.Sub}" HorizontalAlignment="Center" Margin="0,48,0,0"
                       Visibility="{Binding VideosView.IsEmpty, Converter={StaticResource Visible}}" />

            <!-- floating options bar -->
            <Border Grid.Row="3" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="1080" Margin="0,0,0,20"
                    Background="{DynamicResource Bg}" CornerRadius="28" Padding="20,10,10,10" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.45" />
                </Border.Effect>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.RedBig}" c:Ui.Icon="{StaticResource I.Download}" Content="{DynamicResource Download}"
                            Command="{Binding DownloadCommand}" Margin="10,0,0,0" />
                    <WrapPanel VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0" MinWidth="90">
                            <TextBlock Text="{Binding DockCountText}" FontWeight="Bold" />
                            <TextBlock Text="{Binding DockSubText}" Style="{StaticResource T.Small}" />
                        </StackPanel>
                        <Border Width="1" Height="28" Background="{DynamicResource Line}" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Seg.Box}" Margin="0,2,10,2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Seg}" c:Ui.Icon="{StaticResource I.Film}" Content="{DynamicResource Video}"
                                             IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=video}" />
                                <RadioButton Style="{StaticResource Seg}" c:Ui.Icon="{StaticResource I.Music}" Content="{DynamicResource AudioOnlyMode}"
                                             IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=audio}" />
                            </StackPanel>
                        </Border>
                        <ComboBox ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding SelectedQuality}" DisplayMemberPath="Label" IsEnabled="{Binding QualityEnabled}"
                                  Margin="0,2,10,2" MinWidth="150" ToolTip="{DynamicResource Quality}" AutomationProperties.Name="{DynamicResource Quality}" />
                        <ComboBox ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding SelectedFormat}" DisplayMemberPath="Label"
                                  Margin="0,2,10,2" MinWidth="110" ToolTip="{DynamicResource Format}" AutomationProperties.Name="{DynamicResource Format}" />
                        <Button Style="{StaticResource Btn.Pill}" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="1" c:Ui.HoverBackground="{DynamicResource Hover}"
                                c:Ui.Icon="{StaticResource I.Folder}" Margin="0,2,10,2" MaxWidth="220" Command="{Binding ChangeFolderCommand}" FontWeight="Normal"
                                ToolTip="{Binding SaveDirectory}">
                            <TextBlock Text="{Binding SaveDirectory}" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <Grid Margin="0,2,0,2">
                            <ToggleButton x:Name="MoreButton" Style="{StaticResource ChipToggle}" Width="40" Height="40" c:Ui.CornerRadius="20" Background="Transparent"
                                          c:Ui.HoverBackground="{DynamicResource Hover}" c:Ui.Icon="{StaticResource I.Sliders}" c:Ui.IconSize="22" Foreground="{DynamicResource Text2}"
                                          IsChecked="{Binding IsMoreOpen, Mode=TwoWay}" IsHitTestVisible="{Binding IsOpen, ElementName=MorePopup, Converter={StaticResource Not}}"
                                          ToolTip="{DynamicResource MoreOptions}" AutomationProperties.Name="{DynamicResource MoreOptions}" />
                            <Popup x:Name="MorePopup" PlacementTarget="{Binding ElementName=MoreButton}" Placement="Top" VerticalOffset="-8" HorizontalOffset="-140"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{Binding IsMoreOpen, Mode=TwoWay}">
                                <Border Style="{StaticResource PopupCard}" Width="340" Padding="18,12,6,12">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource MoreOptions}" FontWeight="Bold" Margin="0,0,0,4" />
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding SavePlaylistsInDifferentDirectories}" />
                                            <TextBlock Text="{DynamicResource SavePlaylistInUniqueDirectory}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </DockPanel>
                                        <DockPanel Visibility="{Binding IsVideoMode, Converter={StaticResource Visible}}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding DownloadCaptions}" />
                                            <TextBlock Text="{DynamicResource DownloadCaptions}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </DockPanel>
                                        <DockPanel Visibility="{Binding IsAudioMode, Converter={StaticResource Visible}}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding TagAudioFile}" />
                                            <TextBlock Text="{DynamicResource TagAudioFile}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </DockPanel>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding SkipExisting}" />
                                            <TextBlock Text="{DynamicResource SkipExisting}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </WrapPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
