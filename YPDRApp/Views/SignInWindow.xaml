<Window x:Class="YoutubePlaylistDownloader.Views.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:YoutubePlaylistDownloader.Controls"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{DynamicResource SignInWithYoutube}"
        Width="520" Height="740" MinWidth="420" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource Font.Text}"
        FontSize="14"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Icon="/finalIcon.ico">

    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="34" Height="24" CornerRadius="7" Background="{DynamicResource Red}" VerticalAlignment="Top" Margin="0,1,12,0">
                    <c:Icon Data="{StaticResource I.Logo}" Width="17" Height="17" Foreground="White" StrokeThickness="2.4" />
                </Border>
                <TextBlock Text="{DynamicResource SignInWindowHint}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Text2}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid>
            <TextBlock x:Name="Loading" Text="{DynamicResource Loading}" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <wv:WebView2 x:Name="Browser" Visibility="Hidden" />
        </Grid>
    </DockPanel>
</Window>
