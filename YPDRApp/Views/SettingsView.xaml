<UserControl x:Class="YoutubePlaylistDownloader.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:YoutubePlaylistDownloader.Controls">

    <UserControl.Resources>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="20,12,14,12" />
            <Setter Property="MinHeight" Value="64" />
        </Style>
        <Style x:Key="RowFirst" TargetType="Border" BasedOn="{StaticResource Row}">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock" BasedOn="{StaticResource T.Small}">
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource T.H2}">
            <Setter Property="Margin" Value="0,32,0,12" />
        </Style>
        <Style x:Key="TocButton" TargetType="Button" BasedOn="{StaticResource Btn.Menu}">
            <Setter Property="c:Ui.CornerRadius" Value="20" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{DynamicResource Text2}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="38" />
        </Style>
        <Style x:Key="Token" TargetType="Button" BasedOn="{StaticResource Btn.PillSm}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="c:Ui.CornerRadius" Value="8" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="{DynamicResource Settings}" Style="{StaticResource T.H1}" Margin="0,0,0,4" />

        <!-- table of contents -->
        <StackPanel Grid.Row="1" Margin="0,24,24,0">
            <Button Style="{StaticResource TocButton}" Content="{DynamicResource NavDownloads}" Tag="{Binding ElementName=SecDownloads}" Click="Toc_Click" />
            <Button Style="{StaticResource TocButton}" Content="{DynamicResource YoutubeAccount}" Tag="{Binding ElementName=SecAccount}" Click="Toc_Click" />
            <Button Style="{StaticResource TocButton}" Content="{DynamicResource SecFileNames}" Tag="{Binding ElementName=SecNames}" Click="Toc_Click" />
            <Button Style="{StaticResource TocButton}" Content="{DynamicResource Video}" Tag="{Binding ElementName=SecVideo}" Click="Toc_Click" />
            <Button Style="{StaticResource TocButton}" Content="{DynamicResource Audio}" Tag="{Binding ElementName=SecAudio}" Click="Toc_Click" />
            <Button Style="{StaticResource TocButton}" Content="{DynamicResource SecAppearance}" Tag="{Binding ElementName=SecAppearance}" Click="Toc_Click" />
            <Button Style="{StaticResource TocButton}" Content="{DynamicResource SecAdvanced}" Tag="{Binding ElementName=SecAdvanced}" Click="Toc_Click" />
            <Button Style="{StaticResource TocButton}" Content="{DynamicResource Help}" Tag="{Binding ElementName=SecHelp}" Click="Toc_Click" />
            <Button Style="{StaticResource TocButton}" Content="{DynamicResource About}" Tag="{Binding ElementName=SecAbout}" Click="Toc_Click" />
        </StackPanel>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,40,0">
            <StackPanel MaxWidth="800" HorizontalAlignment="Left" Margin="0,0,0,64">

                <!-- ============ downloads ============ -->
                <TextBlock x:Name="SecDownloads" Text="{DynamicResource NavDownloads}" Style="{StaticResource SectionTitle}" Margin="0,16,0,12" />
                <Border Style="{StaticResource Box}">
                    <StackPanel>
                        <Border Style="{StaticResource RowFirst}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Btn.GhostSm}" c:Ui.Icon="{StaticResource I.Open}" Command="{Binding OpenSaveFolderCommand}" ToolTip="{DynamicResource OpenFolder}" AutomationProperties.Name="{DynamicResource OpenFolder}" />
                                    <Button Style="{StaticResource Btn.PillSm}" Content="{DynamicResource ChangeFolder}" Command="{Binding ChangeFolderCommand}" Margin="6,0,0,0" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{DynamicResource DefaultFolder}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{Binding SaveDirectory}" Style="{StaticResource RowHint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ConcurrentOptions}" SelectedItem="{Binding ConcurrentDownloads}" DisplayMemberPath="Label" MinWidth="90" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{DynamicResource ConcurrentDownloads}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{DynamicResource ConcurrentDownloadsHint}" Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding SkipExisting}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{DynamicResource SkipExisting}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{DynamicResource SkipExistingHint}" Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding DetectClipboard}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{DynamicResource DetectClipboard}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{DynamicResource DetectClipboardHint}" Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding NotifyWhenDone}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{DynamicResource NotifyWhenDone}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{DynamicResource NotifyWhenDoneHint}" Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding OpenFolderWhenDone}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource OpenDestinationFolderOnFinish}" Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ConfirmExit}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource ConfirmExit}" Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============ youtube account ============ -->
                <TextBlock x:Name="SecAccount" Text="{DynamicResource YoutubeAccount}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Box}">
                    <StackPanel>
                        <Border Style="{StaticResource RowFirst}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Btn.GhostSm}" Content="{DynamicResource RefreshCookies}" Command="{Binding RefreshCookiesCommand}"
                                            Visibility="{Binding HasCookies, Converter={StaticResource Visible}}" Margin="0,0,6,0" />
                                    <Button Style="{StaticResource Btn.GhostSm}" Content="{DynamicResource RemoveCookies}" Command="{Binding RemoveCookiesCommand}"
                                            Visibility="{Binding HasCookies, Converter={StaticResource Visible}}" Margin="0,0,6,0" />
                                    <Button Style="{StaticResource Btn.RedSm}" c:Ui.Icon="{StaticResource I.User}" Content="{DynamicResource SignInWithYoutube}" Command="{Binding SignInCommand}"
                                            Visibility="{Binding HasCookies, Converter={StaticResource Collapsed}}" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <c:Icon Data="{StaticResource I.CheckCircle}" Width="16" Height="16" Foreground="{DynamicResource Green}" Margin="0,0,6,0"
                                                Visibility="{Binding HasCookies, Converter={StaticResource Visible}}" />
                                        <TextBlock Text="{Binding AccountStatus}" Style="{StaticResource RowTitle}" />
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource YoutubeAccountHint}" Style="{StaticResource RowHint}" />
                                    <Button Style="{StaticResource Btn.Link}" Content="{DynamicResource ImportCookiesInstead}" Command="{Binding ImportCookiesCommand}"
                                            HorizontalAlignment="Left" Margin="-6,2,0,0" FontSize="13" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============ file names ============ -->
                <TextBlock x:Name="SecNames" Text="{DynamicResource SecFileNames}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Box}">
                    <StackPanel>
                        <Border Style="{StaticResource RowFirst}" Padding="20,16,20,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.GhostSm}" Content="{DynamicResource ResetToDefault}" Command="{Binding ResetPatternCommand}" />
                                    <TextBlock Text="{DynamicResource NamePattern}" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBox Text="{Binding FilenamePattern, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AutomationProperties.Name="{DynamicResource NamePattern}" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Style="{StaticResource Token}" Content="+ $title" Command="{Binding InsertTokenCommand}" CommandParameter="$title" />
                                    <Button Style="{StaticResource Token}" Content="+ $index" Command="{Binding InsertTokenCommand}" CommandParameter="$index" />
                                    <Button Style="{StaticResource Token}" Content="+ $artist" Command="{Binding InsertTokenCommand}" CommandParameter="$artist" />
                                    <Button Style="{StaticResource Token}" Content="+ $songtitle" Command="{Binding InsertTokenCommand}" CommandParameter="$songtitle" />
                                    <Button Style="{StaticResource Token}" Content="+ $channel" Command="{Binding InsertTokenCommand}" CommandParameter="$channel" />
                                    <Button Style="{StaticResource Token}" Content="+ $playlist" Command="{Binding InsertTokenCommand}" CommandParameter="$playlist" />
                                    <Button Style="{StaticResource Token}" Content="+ $videoid" Command="{Binding InsertTokenCommand}" CommandParameter="$videoid" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource T.Small}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap">
                                    <Run Text="{DynamicResource NamePreview}" />
                                    <Run Text="{Binding PatternPreview, Mode=OneWay}" Foreground="{DynamicResource Text}" FontWeight="SemiBold" />
                                </TextBlock>
                                <Expander Margin="0,10,0,0" Foreground="{DynamicResource Text2}">
                                    <Expander.Header>
                                        <TextBlock Text="{DynamicResource FileNamePatternTitle}" Style="{StaticResource T.Small}" FontSize="13" />
                                    </Expander.Header>
                                    <TextBlock Text="{DynamicResource FileNamePattenExplanation}" Style="{StaticResource T.Small}" Margin="0,8,0,0" />
                                </Expander>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding SavePlaylistsInDifferentDirectories}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource SavePlaylistInUniqueDirectory}" Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============ video ============ -->
                <TextBlock x:Name="SecVideo" Text="{DynamicResource Video}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Box}">
                    <StackPanel>
                        <Border Style="{StaticResource RowFirst}">
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding PreferredQuality}" DisplayMemberPath="Label" MinWidth="200" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource PreferredQuality}" Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding VideoFormats}" SelectedItem="{Binding VideoFormat}" DisplayMemberPath="Label" MinWidth="200" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource VideoFormat}" Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding PreferHighestFps}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource PreferFPS}" Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding AudioLanguages}" SelectedItem="{Binding AudioLanguage}" DisplayMemberPath="Label" MinWidth="200" MaxDropDownHeight="360" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{DynamicResource AudioTrackLanguage}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{DynamicResource AudioTrackLanguageHint}" Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding DownloadCaptions}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource DownloadCaptions}" Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}" IsEnabled="{Binding DownloadCaptions}">
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding CaptionLanguages}" SelectedItem="{Binding CaptionsLanguage}" DisplayMemberPath="Label" MinWidth="200" MaxDropDownHeight="360" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource CaptionsLanguageLabel}" Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============ audio ============ -->
                <TextBlock x:Name="SecAudio" Text="{DynamicResource Audio}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Box}">
                    <StackPanel>
                        <Border Style="{StaticResource RowFirst}">
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding AudioFormats}" SelectedItem="{Binding AudioFormat}" DisplayMemberPath="Label" MinWidth="200" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{DynamicResource AudioFormat}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{DynamicResource AudioFormatHint}" Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Bitrates}" SelectedItem="{Binding Bitrate}" DisplayMemberPath="Label" MinWidth="200" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource AudioQuality}" Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding TagAudioFile}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{DynamicResource TagAudioFile}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{DynamicResource TagsHint}" Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============ appearance ============ -->
                <TextBlock x:Name="SecAppearance" Text="{DynamicResource SecAppearance}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Box}">
                    <StackPanel>
                        <Border Style="{StaticResource RowFirst}">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Seg.Box}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Seg}" Content="{DynamicResource ThemeSystem}" IsChecked="{Binding ThemeMode, Converter={StaticResource Equals}, ConverterParameter=System}" />
                                        <RadioButton Style="{StaticResource Seg}" c:Ui.Icon="{StaticResource I.Sun}" Content="{DynamicResource ThemeLight}" IsChecked="{Binding ThemeMode, Converter={StaticResource Equals}, ConverterParameter=Light}" />
                                        <RadioButton Style="{StaticResource Seg}" c:Ui.Icon="{StaticResource I.Moon}" Content="{DynamicResource ThemeDark}" IsChecked="{Binding ThemeMode, Converter={StaticResource Equals}, ConverterParameter=Dark}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{DynamicResource ThemeMode}" Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Languages}" SelectedValuePath="Name" SelectedValue="{Binding CurrentLanguage}" MinWidth="220" MaxDropDownHeight="420" VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="22" Height="15" CornerRadius="3" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Name, Converter={StaticResource Flag}}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{DynamicResource Language}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{DynamicResource LanguageHint}" Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============ advanced ============ -->
                <TextBlock x:Name="SecAdvanced" Text="{DynamicResource SecAdvanced}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Box}">
                    <StackPanel>
                        <Border Style="{StaticResource RowFirst}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding ConversionOptions}" SelectedItem="{Binding ConversionsLimit}" DisplayMemberPath="Label" MinWidth="90" IsEnabled="{Binding LimitConversions}" Margin="0,0,8,0" />
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LimitConversions}" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{DynamicResource LimitConversionsLabel}" Style="{StaticResource RowTitle}" />
                                    <Expander Margin="0,4,0,0" Foreground="{DynamicResource Text2}">
                                        <Expander.Header>
                                            <TextBlock Text="{DynamicResource FileConversion}" Style="{StaticResource T.Small}" />
                                        </Expander.Header>
                                        <TextBlock Text="{DynamicResource ConversionsLimitingExplanation}" Style="{StaticResource T.Small}" Margin="0,6,0,0" />
                                    </Expander>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding CheckForUpdates}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource AutomaticallyCheckForUpdates}" Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.PillSm}" c:Ui.Icon="{StaticResource I.Folder}" Content="{DynamicResource OpenLogFolder}" Command="{Binding OpenLogCommand}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{DynamicResource LogFile}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{DynamicResource LogFileHint}" Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.PillSm}" Content="{DynamicResource RestoreDefaults}" Command="{Binding RestoreDefaultsCommand}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource RestoreDefaultsHint}" Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============ help ============ -->
                <TextBlock x:Name="SecHelp" Text="{DynamicResource Help}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Box}" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ContactTheDeveloper}" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{DynamicResource ContactHelp}" Style="{StaticResource T.Small}" FontSize="13" Margin="0,6,0,12" />
                        <Button Style="{StaticResource Btn.PillSm}" c:Ui.Icon="{StaticResource I.Alert}" Content="{DynamicResource ReportProblem}" HorizontalAlignment="Left"
                                Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/danfreitas97/YoutubePlaylistDownloaderRevamped/issues" />
                    </StackPanel>
                </Border>

                <!-- ============ about ============ -->
                <TextBlock x:Name="SecAbout" Text="{DynamicResource About}" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Box}" Padding="20">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="64" Height="45" CornerRadius="13" Background="{DynamicResource Red}" Margin="0,0,16,0">
                                <c:Icon Data="{StaticResource I.Logo}" Width="30" Height="30" Foreground="White" StrokeThickness="2.4" />
                            </Border>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.PillSm}" c:Ui.Icon="{StaticResource I.Retry}" Content="{DynamicResource CheckForUpdates}" Command="{Binding CheckUpdatesNowCommand}" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Title}" FontWeight="Bold" FontSize="16" />
                                <TextBlock Text="{Binding VersionText}" Style="{StaticResource T.Small}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{DynamicResource AboutDisclaimer}" Style="{StaticResource T.Small}" FontSize="13" Margin="0,16,0,0" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Style="{StaticResource Btn.GhostSm}" c:Ui.Icon="{StaticResource I.Open}" Content="GitHub" Margin="0,0,8,0"
                                    Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/danfreitas97/YoutubePlaylistDownloaderRevamped" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
