<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Simplified 3:2 flags for the language picker, drawn on a 30x20 grid. -->

    <DrawingImage x:Key="Flag.English">
        <DrawingImage.Drawing>
            <DrawingGroup ClipGeometry="M0,0 L30,0 L30,20 L0,20 Z">
                <GeometryDrawing Brush="#012169" Geometry="M0,0 L30,0 L30,20 L0,20 Z" />
                <GeometryDrawing Geometry="M0,0 L30,20 M30,0 L0,20">
                    <GeometryDrawing.Pen><Pen Brush="White" Thickness="4" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 L30,20 M30,0 L0,20">
                    <GeometryDrawing.Pen><Pen Brush="#C8102E" Thickness="1.4" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="White" Geometry="M12,0 L18,0 L18,20 L12,20 Z M0,7 L30,7 L30,13 L0,13 Z" />
                <GeometryDrawing Brush="#C8102E" Geometry="M13.2,0 L16.8,0 L16.8,20 L13.2,20 Z M0,8.2 L30,8.2 L30,11.8 L0,11.8 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

